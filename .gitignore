# Dependencies
frontend/node_modules/
backend/__pycache__/
**/__pycache__/
*.pyc

# Build output
frontend/dist/

# Data (user-generated)
data/images/
data/articles/
data/config.json
# 运行时网关配置(令牌明文 + 内联 CA PEM)。生产用 Docker 具名卷(树外);
# 但若 APP_DATA_DIR 指向仓库内 data/,save_stored 会写到这里 — 纵深防御忽略它。
data/gateway.json
data/gateway.json.tmp
# 运行时凭据存储(公众号 AppSecret 明文,按 appid)。同 gateway.json 走具名卷;
# 纵深防御:若 APP_DATA_DIR 指向仓库内 data/ 也绝不入库。
data/credentials.json
data/credentials.json.tmp
# BYOK LLM provider config (plaintext api_key) + learned brand-voice samples.
# Same named-volume story as gateway/credentials; defense-in-depth ignore if
# APP_DATA_DIR points at the in-repo data/ during local dev. NEVER commit a key.
data/llm_provider.json
data/llm_provider.json.tmp
data/brand_voices.json
data/brand_voices.json.tmp
data/*.html
!data/.gitkeep
!data/config.json.example
!data/gateway.json.example

# Dev-only runtime data dir (when running uvicorn from ./backend with
# CONFIG_FILE=backend/data/config.json — see scripts/test_publish_direct.py)
backend/data/

# TypeScript build info (regenerated by editor/tsc on every build)
frontend/tsconfig.tsbuildinfo
frontend/.logs/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Development tools / local agent plans (may contain private ops notes)
docs/superpowers/
docs/superpowers/**
CLAUDE.md
.playwright-mcp/
.playwright-cli/
# Brainstorming visual-companion mockups + session state (local, not portable)
.superpowers/

# Ops handoffs — contain deployment IPs / SSH / hostnames; never commit to a
# public repo. Keep locally; route any durable ops fact into agent memory
# (which is itself gitignored) instead. See sensitive-data-redaction rule.
docs/handoff/
docs/handoff/**

# Private keys / credentials — never commit
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# Deployment-local TLS certs (SAN contains the server IP; per-box, not portable)
certs/

# Playwright visual test artifacts and auth state
backend/tests/visual/.auth/
backend/tests/visual/_artifacts/

# pip install -e artifacts
*.egg-info/

# Local agent / session state (not portable across machines)
.claude/
.omx/
data/mbdocs/
memory/

# Local scratch dropped at repo root (zipped exports, screenshots, design
# handoffs). Catches every *.png / *.jpg / *.jpeg at the repo root — any image
# meant to ship needs to live under docs/, frontend/, or backend/.
/MBEditor/
/MBEditor.zip
/*.png
/*.jpg
/*.jpeg

# Local git worktrees (per-branch physical checkouts, not portable)
.worktrees/

# Agent scratch: temp workflow scripts + visual-direction mockups (local only)
.tmp-*
.tmp-mockups/
# Real brand logo source (reference assets; shipped logo is an inline SVG component)
MBEditor-logo/

# design-sync upload staging (logo + brief)
ds-bundle/

# design-sync local state (project pin + internal redesign notes — never push to public github)
.design-sync/
